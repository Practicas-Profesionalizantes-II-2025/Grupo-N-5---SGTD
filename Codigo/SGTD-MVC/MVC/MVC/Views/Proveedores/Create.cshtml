@model MVC.Models.DTOs.ProveedorDto.ProveedorCreateDTO

@{
    ViewData["Title"] = "Añadir Proveedor";
}

<link rel="stylesheet" href="~/css/createBase.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/select.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/multipleSelect.css" asp-append-version="true" />


<div class="content-container p-4 add-proveedor-page">
    <div class="form-card">
        <h2 class="form-title">AÑADIR PROVEEDOR</h2>

        <form asp-action="Create" method="post">
			<div class="form-row">
                <div style="width:100%;">
                    <div class="custom-multiple-select-container multiple" data-name="RubroIds" style="width:100%;">
                        <button type="button" class="custom-multiple-select-trigger">
                            <span class="selected-value placeholder">Seleccione uno o más rubros</span>
                            <span class="arrow">▼</span>
                        </button>

                        @if (ViewBag.Rubros != null && ((IEnumerable<MVC.Models.DTOs.RubroDto.RubroReadDTO>)ViewBag.Rubros).Any())
                        {
                            <ul class="custom-multiple-select-options">
                                @foreach (var rubro in (IEnumerable<MVC.Models.DTOs.RubroDto.RubroReadDTO>)ViewBag.Rubros)
                                {
                                    <li data-value="@rubro.Id">@rubro.Nombre</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <ul class="custom-multiple-select-options">
                                <li class="disabled">No hay disciplinas disponibles</li>
                            </ul>
                        }
                        <div class="hidden-inputs"></div>
                    </div>
                    @Html.ValidationMessageFor(m => m.RubroIds, "", new { @class = "text-danger" })
                </div>                
            </div>
            <div class="form-row">
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-input", placeholder = "Nombre", required = "required" })
                    @Html.ValidationMessageFor(m => m.Nombre)
                </div>
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-input", placeholder = "Correo Electrónico", required = "required" })
                    @Html.ValidationMessageFor(m => m.Correo)
                </div>
            </div>
            <div class="form-row">
                <!-- Select de Provincias -->
                <div style="width:100%;">
                    <div class="custom-select-container" id="provinciaSelect">
                        <button type="button" class="custom-select-trigger">
                            <span class="selected-value placeholder">Seleccione provincia</span>
                            <span class="arrow">▼</span>
                        </button>

                        <ul class="custom-select-options">
                            @if (ViewBag.Provincias != null && ((IEnumerable<MVC.Controllers.ProvinciaDTO>)ViewBag.Provincias).Any())
                            {
                                @foreach (var prov in (IEnumerable<MVC.Controllers.ProvinciaDTO>)ViewBag.Provincias)
                                {
                                    <li data-value="@prov.Id">@prov.Nombre</li>
                                }
                            }
                            else
                            {
                                <ul class="custom-multiple-select-options">
                                    <li class="disabled">Error, no hay provincias disponibles</li>
                                </ul>
                            }
                        </ul>

                        <input type="hidden" name="ProvinciaId" />
                        <input type="hidden" id="ProvinciaNombre" name="Provincia" />
                    </div>
                    @Html.ValidationMessageFor(m => m.Provincia, "", new { @class = "field-validation-error" })
                </div>

                <!-- Select de Ciudades -->
                <div style="width:100%;">
                    <div class="custom-select-container" id="ciudadSelect">
                        <button type="button" class="custom-select-trigger">
                            <span class="selected-value placeholder">Seleccione ciudad</span>
                            <span class="arrow">▼</span>
                        </button>
                        <ul class="custom-select-options">
                            <!-- Vacío: se llenará dinámicamente al seleccionar provincia -->
                        </ul>
                        <input type="hidden" name="CiudadId" />
                        <input type="hidden" id="CiudadNombre" name="Ciudad" />
                    </div>
                    @Html.ValidationMessageFor(m => m.Ciudad)
                </div>
                <div style ="width:100%;">
                    @Html.TextBoxFor(m => m.Direccion, new { @class = "form-input", placeholder = "Direccion", required = "required" })
                    @Html.ValidationMessageFor(m => m.Direccion)
                </div>
            </div>
            <div class="form-row">
                <div style="width:100%;">
					@Html.TextBoxFor(m => m.Cuit, new { @class = "form-input", placeholder = "CUIT", required = "required" })
					@Html.ValidationMessageFor(m => m.Cuit)
                </div>
                <div style="width:100%;">
					@Html.TextBoxFor(m => m.Telefono, new { @class = "form-input", placeholder = "Teléfono", required = "required" })
					@Html.ValidationMessageFor(m => m.Telefono)
                </div>
            </div>

            <div class="estado-row">
                <div>
                    <label>Estado:</label>
                </div>
                <div>
                    <label class="switch">
                        <input type="checkbox" id="estadoSwitch" />
                        <span class="slider round"></span>
                    </label>
                    <span id="estadoLabel" class="switch-label">Inactivo</span>
                </div>
            </div>

            <!-- Campo oculto que viaja en el POST -->
            <input type="hidden" id="EstadoId" name="EstadoId" value="4" />

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-lg btn-edit">VOLVER</a>
                <button type="submit" class="btn btn-lg btn-add">AÑADIR</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/select.js" defer asp-append-version="true"></script>
    <script src="~/js/multipleSelect.js" defer asp-append-version="true"></script>
    <script src="~/js/switch.js" defer asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const provinciaContainer = document.getElementById("provinciaSelect");
            const ciudadContainer = document.getElementById("ciudadSelect");

            const ciudadOptionsList = ciudadContainer.querySelector(".custom-select-options");

            provinciaContainer.addEventListener("custom-select:change", async (e) => {
                const provinciaNombre = e.detail.text;
                const provinciaInput = provinciaContainer.querySelector("#ProvinciaNombre");
                provinciaInput.value = provinciaNombre; // <-- asignamos el nombre

                // Limpiar ciudades
                ciudadOptionsList.innerHTML = "";
                ciudadContainer.querySelector(".selected-value").textContent = "Seleccione ciudad";
                ciudadContainer.querySelector("input[name=CiudadId]").value = "";
                ciudadContainer.querySelector("#CiudadNombre").value = "";

                try {
                    const res = await fetch(`/Proveedores/GetCiudades?provinciaNombre=${encodeURIComponent(provinciaNombre)}`);
                    const ciudades = await res.json();

                    ciudades.sort((a, b) => a.nombre.localeCompare(b.nombre));

                    ciudades.forEach(c => {
                        const li = document.createElement("li");
                        li.textContent = c.nombre;
                        li.dataset.value = c.id || c.nombre;
                        ciudadOptionsList.appendChild(li);
                    });
                } catch (err) {
                    console.error("Error cargando ciudades:", err);
                }
            });

            // Para la ciudad, si tu select dispara el mismo evento:
            ciudadContainer.addEventListener("custom-select:change", (e) => {
                const ciudadNombre = e.detail.text;
                const ciudadInput = ciudadContainer.querySelector("#CiudadNombre");
                ciudadInput.value = ciudadNombre;
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const multipleSelectContainer = document.querySelector(".custom-multiple-select-container.multiple");
            if (!multipleSelectContainer) return; // nada que hacer

            const multipleSelectOpciones = multipleSelectContainer.querySelector(".custom-multiple-select-options");
            const hiddenInputsContainer = multipleSelectContainer.querySelector(".hidden-inputs");
            const triggerValueEl = multipleSelectContainer.querySelector(".custom-multiple-select-trigger .selected-value");

            // Helper: crea <li> y le pone listener
            function crearLiConListener(id, nombre) {
                const li = document.createElement("li");
                li.dataset.value = id;
                li.textContent = nombre;
                li.addEventListener("click", e => {
                    e.stopPropagation();

                    li.classList.toggle("selected");
                    const value = li.dataset.value;

                    if (li.classList.contains("selected")) {
                        // evitar duplicados
                        if (!hiddenInputsContainer.querySelector(`input[data-value="${value}"]`)) {
                            const input = document.createElement("input");
                            input.type = "hidden";
                            input.name = multipleSelectContainer.dataset.name;
                            input.value = value;
                            input.dataset.value = value;
                            hiddenInputsContainer.appendChild(input);
                        }
                    } else {
                        const input = hiddenInputsContainer.querySelector(`input[data-value="${value}"]`);
                        if (input) input.remove();
                    }

                    actualizarTriggerTexto();
                });
                return li;
            }

            function actualizarTriggerTexto() {
                const selectedTexts = Array.from(multipleSelectOpciones.querySelectorAll("li.selected"))
                    .map(li => li.textContent.trim());
                triggerValueEl.textContent = selectedTexts.length > 0 ? selectedTexts.join(", ") : "Seleccione uno o más rubros";
                triggerValueEl.classList.toggle("placeholder", selectedTexts.length === 0);
            }

            // Llena el <ul> a partir de una lista de filas <tr> (NodeList o Array)
            function llenarDesdeFilas(rows) {
                // preservar selecciones actuales
                const seleccionadosActuales = Array.from(hiddenInputsContainer.querySelectorAll("input"))
                    .map(i => i.value);

                multipleSelectOpciones.innerHTML = "";
                // crear li por cada fila
                rows.forEach(row => {
                    const id = row.dataset.id;
                    const nombre = row.querySelector(".rubro-disciplina")?.textContent?.trim();
                    if (!id || !nombre) return;

                    const li = crearLiConListener(id, nombre);
                    if (seleccionadosActuales.includes(id)) {
                        li.classList.add("selected");
                        // si no existe input (por alguna razón), lo recreo
                        if (!hiddenInputsContainer.querySelector(`input[data-value="${id}"]`)) {
                            const input = document.createElement("input");
                            input.type = "hidden";
                            input.name = multipleSelectContainer.dataset.name;
                            input.value = id;
                            input.dataset.value = id;
                            hiddenInputsContainer.appendChild(input);
                        }
                    }
                    multipleSelectOpciones.appendChild(li);
                });

                actualizarTriggerTexto();
            }

            // Si la tabla del modal está en DOM, la usamos, sino la pedimos por fetch a tu action GetRubros (partial)
            async function actualizarDropdownRubros() {
                let tablaContainer = document.getElementById("tablaRubrosContainer");

                if (tablaContainer && tablaContainer.querySelectorAll("tbody tr[data-id]").length > 0) {
                    // ya hay filas en el DOM
                    llenarDesdeFilas(Array.from(tablaContainer.querySelectorAll("tbody tr[data-id]")));
                    return;
                }

                // Si no existe la tabla o está vacía, intentar obtenerla desde la acción que devuelve la partial
                try {
                    const res = await fetch("/Rubros/GetRubros", { method: "GET", headers: { "X-Requested-With": "XMLHttpRequest" } });
                    if (!res.ok) {
                        console.warn("No se pudo traer partial de rubros:", res.status);
                        return;
                    }
                    const html = await res.text();
                    // parsear HTML recibido y buscar filas
                    const tmp = document.createElement("div");
                    tmp.innerHTML = html;
                    const rows = tmp.querySelectorAll("tbody tr[data-id]"); // NodeList
                    if (rows.length === 0) {
                        // tal vez la partial devuelve otro markup; no hay filas
                        console.warn("Partial de rubros sin filas");
                        multipleSelectOpciones.innerHTML = "";
                        return;
                    }
                    llenarDesdeFilas(Array.from(rows));
                    return;
                } catch (err) {
                    console.error("Error fetch GetRubros:", err);
                }
            }

            // Cuando se cierra el modal de rubros, re-sincronizar
            const modalRubros = document.getElementById("modalRubros");
            if (modalRubros) {
                modalRubros.addEventListener("hidden.bs.modal", () => {
                    actualizarDropdownRubros();
                });
            }

            // Inicializar al cargar página (intenta usar tabla en DOM o hace fetch)
            actualizarDropdownRubros();
        });
    </script>
}
