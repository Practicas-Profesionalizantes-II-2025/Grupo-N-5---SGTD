@model MVC.Models.DTOs.ProveedorDto.ProveedorCreateDTO

@{
    ViewData["Title"] = "Añadir Proveedor";
}

<link rel="stylesheet" href="~/css/createBase.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/select.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/multipleSelect.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/validation.css" asp-append-version="true" /> 

<div class="content-container p-4 add-proveedor-page">
    <div class="form-card">
        <h2 class="form-title">AÑADIR PROVEEDOR</h2>

        <form asp-action="Create" method="post">
            <div class="form-row">
                <div style="width:100%; margin-bottom: 20px;">
                    <div class="custom-multiple-select-container multiple @(ViewData.ModelState["RubroIds"]?.Errors.Count > 0 ? "input-validation-error" : "")" data-name="Rubros">
                        <button type="button" class="custom-multiple-select-trigger">
                            <span class="selected-value placeholder">Seleccione uno o más rubros</span>
                            <span class="arrow">▼</span>
                        </button>

                        @if (ViewBag.Rubros != null && ((IEnumerable<MVC.Models.DTOs.RubroDto.RubroReadDTO>)ViewBag.Rubros).Any())
                        {
                            <ul class="custom-multiple-select-options">
                                @foreach (var rubro in (IEnumerable<MVC.Models.DTOs.RubroDto.RubroReadDTO>)ViewBag.Rubros)
                                {
                                    <li data-value="@rubro.Id">@rubro.Nombre</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <ul class="custom-multiple-select-options">
                                <li class="disabled">No hay rubros disponibles</li>
                            </ul>
                        }
                        <div class="hidden-inputs"></div>
                        @Html.ValidationMessageFor(m => m.RubroIds, "", new { @class = "validation-error" }) 
                    </div>                    
                </div>
            </div>

            <div class="form-row">
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-input", placeholder = "Nombre"})
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "validation-error" }) 
                </div>
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-input", placeholder = "Correo Electrónico"})
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "validation-error" }) 
                </div>
            </div>

            <div class="form-row">
                <!-- Select de Provincias -->
                <div style="width:100%; margin-bottom: 20px;">
					<div class="custom-select-container @(ViewData.ModelState["Provincia"]?.Errors.Count > 0 ? "input-validation-error" : "")" id="provinciaSelect">
                        <button type="button" class="custom-select-trigger">
                            <span class="selected-value placeholder">Seleccione provincia</span>
                            <span class="arrow">▼</span>
                        </button>

                        <ul class="custom-select-options ">
                            @if (ViewBag.Provincias != null && ((IEnumerable<MVC.Controllers.ProvinciaDTO>)ViewBag.Provincias).Any())
                            {
                                @foreach (var prov in (IEnumerable<MVC.Controllers.ProvinciaDTO>)ViewBag.Provincias)
                                {
                                    <li data-value="@prov.Id">@prov.Nombre</li>
                                }
                            }
                            else
                            {
                                <ul class="custom-multiple-select-options">
                                    <li class="disabled">Error, no hay provincias disponibles</li>
                                </ul>
                            }
                        </ul>

                        <input type="hidden" name="ProvinciaId" />
						<input type="hidden" id="ProvinciaNombre" name="Provincia" />
                        @Html.ValidationMessageFor(m => m.Provincia, "", new { @class = "validation-error" })
                    </div>                    
                </div>

                <!-- Select de Ciudades -->
                <div style="width:100%; margin-bottom: 20px;">
                    <div class="custom-select-container @(ViewData.ModelState["Ciudad"]?.Errors.Count > 0 ? "input-validation-error" : "")" id="ciudadSelect">
                        <button type="button" class="custom-select-trigger">
                            <span class="selected-value placeholder">Seleccione ciudad</span>
                            <span class="arrow">▼</span>
                        </button>
                        <ul class="custom-select-options">
                            <!-- Vacío: se llenará dinámicamente al seleccionar provincia -->
                        </ul>
                        <input type="hidden" name="CiudadId" />
						<input type="hidden" id="CiudadNombre" name="Ciudad" />
                        @Html.ValidationMessageFor(m => m.Ciudad, "", new { @class = "validation-error" })
					</div>                   
                </div>
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Direccion, new { @class = "form-input", placeholder = "Direccion"})
                    @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "validation-error" }) 
                </div>
            </div>

            <div class="form-row">
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Cuit, new { @class = "form-input", placeholder = "CUIT" })
                    @Html.ValidationMessageFor(m => m.Cuit, "", new { @class = "validation-error" })
                </div>
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-input", placeholder = "Teléfono"})
                    @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "validation-error" }) 
                </div>
            </div>

            <div class="estado-row">
                <div>
                    <label>Estado:</label>
                </div>
                <div>
                    <label class="switch">
                        <input type="checkbox" id="estadoSwitch" />
                        <span class="slider round"></span>
                    </label>
                    <span id="estadoLabel" class="switch-label">Inactivo</span>
                </div>
            </div>

            <!-- Campo oculto que viaja en el POST -->
            <input type="hidden" id="EstadoId" name="EstadoId" value="4" />

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-lg btn-edit">VOLVER</a>
                <button type="submit" class="btn btn-lg btn-add">AÑADIR</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/select.js" defer asp-append-version="true"></script>
    <script src="~/js/multipleSelect.js" defer asp-append-version="true"></script>
    <script src="~/js/switch.js" defer asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Apuntar específicamente al multiple select de Rubros
            const multipleSelectContainer = document.querySelector('.custom-multiple-select-container[data-name="Rubros"]');
            if (!multipleSelectContainer) return;

            const multipleSelectOpciones = multipleSelectContainer.querySelector('.custom-multiple-select-options');
            const hiddenInputsContainer = multipleSelectContainer.querySelector('.hidden-inputs');
            const triggerValueEl = multipleSelectContainer.querySelector('.custom-multiple-select-trigger .selected-value');

            // Crear <li> con listener para el multiple select (igual que en Productos)
            function crearLiRubro(id, nombre) {
                const li = document.createElement('li');
                li.dataset.value = id;
                li.textContent = nombre;
                li.addEventListener('click', e => {
                    e.stopPropagation();
                    li.classList.toggle('selected');
                    const value = li.dataset.value;

                    if (li.classList.contains('selected')) {
                        if (!hiddenInputsContainer.querySelector(`input[data-value="${value}"]`)) {
                            const input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = multipleSelectContainer.dataset.name; // "Rubros"
                            input.value = value;
                            input.dataset.value = value;
                            hiddenInputsContainer.appendChild(input);
                        }
                    } else {
                        const input = hiddenInputsContainer.querySelector(`input[data-value="${value}"]`);
                        if (input) input.remove();
                    }

                    actualizarTriggerTexto();
                });
                return li;
            }

            function actualizarTriggerTexto() {
                const selectedTexts = Array.from(multipleSelectOpciones.querySelectorAll('li.selected'))
                    .map(li => li.textContent.trim());
                triggerValueEl.textContent = selectedTexts.length > 0 ? selectedTexts.join(', ') : 'Seleccione uno o más rubros';
                triggerValueEl.classList.toggle('placeholder', selectedTexts.length === 0);
            }

            function llenarDesdeArrayRubros(arr) {
                multipleSelectOpciones.innerHTML = '';
                if (!arr || arr.length === 0) {
                    multipleSelectOpciones.innerHTML = '<li class="disabled">No hay rubros disponibles</li>';
                    actualizarTriggerTexto();
                    return;
                }

                // conservar seleccionados previos (si existen)
                const seleccionadosActuales = Array.from(hiddenInputsContainer.querySelectorAll('input'))
                    .map(i => i.value);

                arr.forEach(r => {
                    // r puede venir como objeto { id, nombre } o { Id, Nombre }
                    const id = r.id ?? r.Id ?? r.value ?? null;
                    const nombre = r.nombre ?? r.Nombre ?? r.name ?? r.NombreRubro ?? null;
                    if (!id || !nombre) return;

                    const li = crearLiRubro(id, nombre);
                    if (seleccionadosActuales.includes(String(id))) {
                        li.classList.add('selected');
                        if (!hiddenInputsContainer.querySelector(`input[data-value="${id}"]`)) {
                            const input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = multipleSelectContainer.dataset.name;
                            input.value = id;
                            input.dataset.value = id;
                            hiddenInputsContainer.appendChild(input);
                        }
                    }
                    multipleSelectOpciones.appendChild(li);
                });

                actualizarTriggerTexto();
            }

            // Parsea HTML parcial (tabla o ul) devuelto por el servidor
            function parsearHtmlYllenar(htmlText) {
                const tmp = document.createElement('div');
                tmp.innerHTML = htmlText;

                // 1) Intentar encontrar filas <tr data-id>
                const rows = tmp.querySelectorAll('tbody tr[data-id]');
                if (rows.length > 0) {
                    const arr = Array.from(rows).map(r => {
                        const id = r.dataset.id;
                        const nombre = r.querySelector('.rubro-disciplina')?.textContent?.trim() || r.querySelector('td')?.textContent?.trim();
                        return { id, nombre };
                    });
                    llenarDesdeArrayRubros(arr);
                    return;
                }

                // 2) Intentar encontrar li[data-value] dentro del HTML recibido
                const lis = tmp.querySelectorAll('li[data-value]');
                if (lis.length > 0) {
                    const arr = Array.from(lis).map(li => ({ id: li.dataset.value, nombre: li.textContent.trim() }));
                    llenarDesdeArrayRubros(arr);
                    return;
                }

                // 3) Si nada, dejar mensaje vacío
                multipleSelectOpciones.innerHTML = '<li class="disabled">No hay rubros disponibles</li>';
                actualizarTriggerTexto();
            }

            // Funcion principal: intenta cargar rubros ya presentes en DOM (modal/table) o hace fetch
            async function actualizarDropdownRubros() {
                // 1) Si existe tabla de rubros (por modal) que ya tiene filas, tomar de ahi
                let tablaContainer = document.getElementById('tablaRubrosContainer');
                if (tablaContainer && tablaContainer.querySelectorAll('tbody tr[data-id]').length > 0) {
                    const rows = Array.from(tablaContainer.querySelectorAll('tbody tr[data-id]'));
                    const arr = rows.map(r => {
                        const id = r.dataset.id;
                        const nombre = r.querySelector('.rubro-disciplina')?.textContent?.trim() || r.querySelector('td')?.textContent?.trim();
                        return { id, nombre };
                    });
                    llenarDesdeArrayRubros(arr);
                    return;
                }

                // 2) Hacer fetch a la acción que devuelve Rubros
                try {
                    const res = await fetch('/Proveedores/GetRubros', { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) {
                        console.warn('No se pudo traer rubros:', res.status);
                        multipleSelectOpciones.innerHTML = '<li class="disabled">No se pudieron cargar rubros</li>';
                        return;
                    }

                    const contentType = (res.headers.get('content-type') || '').toLowerCase();

                    if (contentType.includes('application/json')) {
                        // Si la API devuelve JSON (lista de rubros)
                        const data = await res.json();
                        // data puede ser array de objetos { id/nombre } o { Id/Nombre }
                        llenarDesdeArrayRubros(data);
                        return;
                    }

                    // Si no es JSON, tratamos como HTML parcial
                    const html = await res.text();
                    parsearHtmlYllenar(html);
                } catch (err) {
                    console.error('Error fetch GetRubros:', err);
                    multipleSelectOpciones.innerHTML = '<li class="disabled">Error cargando rubros</li>';
                    actualizarTriggerTexto();
                }
            }

            // Si hay modal para rubros, refrescar al cerrarse (coincide con tu lógica previa)
            const modalRubros = document.getElementById('modalRubros');
            if (modalRubros) {
                modalRubros.addEventListener('hidden.bs.modal', () => actualizarDropdownRubros());
            }

            // Inicializar
            actualizarDropdownRubros();
        });
    </script>
}
