@model MVC.Models.DTOs.ProveedorDto.ProveedorUpdateDTO

@{
    ViewData["Title"] = "Editar Proveedor";
}

<link rel="stylesheet" href="~/css/createBase.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/select.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/multipleSelect.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/validation.css" asp-append-version="true" />

<div class="content-container p-4 edit-proveedor-page">
    <div class="form-card">
        <h2 class="form-title">EDITAR PROVEEDOR</h2>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <!-- Rubros -->
            <div class="form-row">
                <div style="width:100%; margin-bottom: 20px;">
                    <div class="custom-multiple-select-container multiple @(ViewData.ModelState["RubroIds"]?.Errors.Count > 0 ? "input-validation-error" : "")" data-name="RubroIds">
                        <button type="button" class="custom-multiple-select-trigger">
                            <span class="selected-value placeholder">
                                @(Model.RubroIds != null && Model.RubroIds.Any() ? "Rubros seleccionados" : "Seleccione uno o más rubros")
                            </span>
                            <span class="arrow">▼</span>
                        </button>

                        @if (ViewBag.Rubros != null && ((IEnumerable<MVC.Models.DTOs.RubroDto.RubroReadDTO>)ViewBag.Rubros).Any())
                        {
                            <ul class="custom-multiple-select-options">
                                @foreach (var rubro in (IEnumerable<MVC.Models.DTOs.RubroDto.RubroReadDTO>)ViewBag.Rubros)
                                {
                                    var selected = Model.RubroIds != null && Model.RubroIds.Contains(rubro.Id);
                                    <li data-value="@rubro.Id" class="@(selected ? "selected" : "")">@rubro.Nombre</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <ul class="custom-multiple-select-options">
                                <li class="disabled">No hay rubros disponibles</li>
                            </ul>
                        }
						<div class="hidden-inputs"></div>
                        @Html.ValidationMessageFor(m => m.RubroIds, "", new { @class = "validation-error" })
                    </div>
                </div>
            </div>

            <!-- Datos principales -->
            <div class="form-row">
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-input", placeholder = "Nombre"})
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "validation-error" })
                </div>
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-input", placeholder = "Correo Electrónico"})
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "validation-error" })
                </div>
            </div>

            <!-- Ubicación -->
            <div class="form-row">
                <!-- Provincias -->
                <div style="width:100%; margin-bottom: 20px;">
                    <div class="custom-select-container @(ViewData.ModelState["Provincia"]?.Errors.Count > 0 ? "input-validation-error" : "")" id="provinciaSelect">
                        <button type="button" class="custom-select-trigger">
                            <span class="selected-value">@(!string.IsNullOrEmpty(Model.Provincia) ? Model.Provincia : "Seleccione provincia")</span>
                            <span class="arrow">▼</span>
                        </button>
                        <ul class="custom-select-options">
                            @if (ViewBag.Provincias != null && ((IEnumerable<MVC.Controllers.ProvinciaDTO>)ViewBag.Provincias).Any())
                            {
                                @foreach (var prov in (IEnumerable<MVC.Controllers.ProvinciaDTO>)ViewBag.Provincias)
                                {
                                    var selected = Model.Provincia == prov.Nombre;
                                    <li data-value="@prov.Nombre" class="@(selected ? "selected" : "")">@prov.Nombre</li>
                                }
                            }
                            else
                            {
                                <li class="disabled">Error, no hay provincias disponibles</li>
                            }
                        </ul>

						<input type="hidden" id="ProvinciaNombre" name="Provincia" value="@Model.Provincia" />
                        @Html.ValidationMessageFor(m => m.Provincia, "", new { @class = "validation-error" })
                    </div>
                </div>

                <!-- Ciudades -->
                <div style="width:100%; margin-bottom: 20px;">
                    <div class="custom-select-container @(ViewData.ModelState["Ciudad"]?.Errors.Count > 0 ? "input-validation-error" : "")" id="ciudadSelect">
                        <button type="button" class="custom-select-trigger">
                            <span class="selected-value">@(!string.IsNullOrEmpty(Model.Ciudad) ? Model.Ciudad : "Seleccione ciudad")</span>
                            <span class="arrow">▼</span>
                        </button>
                        <ul class="custom-select-options">
                            @if (ViewBag.Ciudades != null && ((IEnumerable<MVC.Controllers.CiudadDTO>)ViewBag.Ciudades).Any())
                            {
                                foreach (var ciudad in (IEnumerable<MVC.Controllers.CiudadDTO>)ViewBag.Ciudades)
                                {
                                    var selected = Model.Ciudad == ciudad.Nombre;
                                    <li data-value="@ciudad.Nombre" class="@(selected ? "selected" : "")">@ciudad.Nombre</li>
                                }
                            }
                            else if (!string.IsNullOrEmpty(Model.Ciudad))
                            {
                                <li data-value="@Model.Ciudad" class="selected">@Model.Ciudad</li>
                            }
                        </ul>
						<input type="hidden" id="CiudadNombre" name="Ciudad" value="@Model.Ciudad" />
                        @Html.ValidationMessageFor(m => m.Ciudad, "", new { @class = "validation-error" })
                    </div>
                </div>

                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Direccion, new { @class = "form-input", placeholder = "Dirección"})
                    @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "validation-error" })
                </div>
            </div>

            <!-- CUIT y Teléfono -->
            <div class="form-row">
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Cuit, new { @class = "form-input", placeholder = "CUIT"})
                    @Html.ValidationMessageFor(m => m.Cuit, "", new { @class = "validation-error" })
                </div>
                <div style="width:100%;">
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-input", placeholder = "Teléfono"})
                    @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "validation-error" })
                </div>
            </div>

            <!-- Estado -->
            <div class="estado-row">
                <div><label>Estado:</label></div>
                <div>
                    <label class="switch">
                        <input type="checkbox" id="estadoSwitch" @(Model.EstadoId == 1 ? "checked" : "") />
                        <span class="slider round"></span>
                    </label>
                    <span id="estadoLabel" class="switch-label">@(Model.EstadoId == 1 ? "Activo" : "Inactivo")</span>
                </div>
            </div>
            <input type="hidden" id="EstadoId" name="EstadoId" value="@Model.EstadoId" />

            <!-- Botones -->
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-lg btn-edit">VOLVER</a>
                <button type="submit" class="btn btn-lg btn-add">GUARDAR</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/select.js" defer asp-append-version="true"></script>
    <script src="~/js/multipleSelect.js" defer asp-append-version="true"></script>
    <script src="~/js/switch.js" defer asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
          const container = document.querySelector('.custom-multiple-select-container[data-name="RubroIds"]');
          if (!container) return;

          const ul = container.querySelector('.custom-multiple-select-options');
          const hiddenContainer = container.querySelector('.hidden-inputs') || (function(){
            const d = document.createElement('div'); d.className='hidden-inputs'; container.appendChild(d); return d;
          })();
          const triggerValue = container.querySelector('.custom-multiple-select-trigger .selected-value');

          // Crear hidden inputs a partir de li.selected si no existen
          const selectedLis = Array.from(ul.querySelectorAll('li.selected'));
          selectedLis.forEach(li => {
            const val = li.dataset.value;
            // si ya hay un input con ese data-value no hacemos nada
            if (!hiddenContainer.querySelector(`input[data-value="${val}"]`)) {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'RubroIds'; // coincide con data-name modificado
              input.value = val;
              input.dataset.value = val;
              hiddenContainer.appendChild(input);
            }
          });

          // Actualizar el texto del trigger con los seleccionados
          function actualizarTriggerDesdeLis() {
            const textos = Array.from(ul.querySelectorAll('li.selected')).map(li => li.textContent.trim());
            if (triggerValue) {
              triggerValue.textContent = textos.length > 0 ? textos.join(', ') : (triggerValue.dataset.placeholder || 'Seleccione uno o más rubros');
              triggerValue.classList.toggle('placeholder', textos.length === 0);
            }
          }
          // guardar placeholder si existe
          if (triggerValue && !triggerValue.dataset.placeholder) {
            triggerValue.dataset.placeholder = triggerValue.classList.contains('placeholder') ? triggerValue.textContent : 'Seleccione uno o más rubros';
          }

          actualizarTriggerDesdeLis();

          // Observador: si en algún momento se reemplaza el UL dinámicamente, re-ejecutar la sincronización
          const mo = new MutationObserver(() => {
            // crear inputs para cualquier seleccionado nuevo
            Array.from(ul.querySelectorAll('li.selected')).forEach(li => {
              const v = li.dataset.value;
              if (!hiddenContainer.querySelector(`input[data-value="${v}"]`)) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'RubroIds';
                input.value = v;
                input.dataset.value = v;
                hiddenContainer.appendChild(input);
              }
            });
            // si hay inputs sin li.selected (por ejemplo deseleccionados), eliminarlos
            Array.from(hiddenContainer.querySelectorAll('input[data-value]')).forEach(inp => {
              if (!ul.querySelector(`li[data-value="${inp.dataset.value}"].selected`)) {
                inp.remove();
              }
            });
            actualizarTriggerDesdeLis();
          });

          mo.observe(ul, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const provinciaContainer = document.getElementById("provinciaSelect");
            const ciudadContainer = document.getElementById("ciudadSelect");
            const ciudadOptionsList = ciudadContainer.querySelector(".custom-select-options");

            // Cambio de provincia
            provinciaContainer.addEventListener("custom-select:change", async (e) => {
                const provinciaNombre = e.detail.text;
                provinciaContainer.querySelector("#ProvinciaNombre").value = provinciaNombre;

                ciudadOptionsList.innerHTML = "";
                ciudadContainer.querySelector(".selected-value").textContent = "Seleccione ciudad";
                ciudadContainer.querySelector("#CiudadNombre").value = "";

                try {
                    const res = await fetch(`/Proveedores/GetCiudades?provinciaNombre=${encodeURIComponent(provinciaNombre)}`);
                    const ciudades = await res.json();
                    ciudades.sort((a, b) => a.nombre.localeCompare(b.nombre));

                    ciudades.forEach(c => {
                        const li = document.createElement("li");
                        li.textContent = c.nombre;
                        li.dataset.value = c.nombre;
                        ciudadOptionsList.appendChild(li);
                    });
                } catch (err) {
                    console.error("Error cargando ciudades:", err);
                }
            });

            // Cambio de ciudad
            ciudadContainer.addEventListener("custom-select:change", (e) => {
                const ciudadNombre = e.detail.text;
                ciudadContainer.querySelector("#CiudadNombre").value = ciudadNombre;
            });
        });
    </script>
}
