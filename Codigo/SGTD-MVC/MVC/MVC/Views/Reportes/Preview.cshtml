@{
    ViewData["Title"] = "Vista previa de factura";
}

<h2>Vista previa de Factura</h2>

@if (ViewBag.PdfBase64 != null)
{
    <iframe src="data:application/pdf;base64,@ViewBag.PdfBase64"
            width="100%" height="800px"
            style="border: none;">
    </iframe>
}
else
{
    <p>No se pudo cargar la factura.</p>
}

<a class="btn btn-secondary mt-3" href="@Url.Action("Index", "Reportes")">Volver</a>
