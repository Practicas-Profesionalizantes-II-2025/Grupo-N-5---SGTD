@model MVC.Models.DTOs.FacturaDto.FacturaCreateDTO

@{
    ViewData["Title"] = "Generar Factura";
}

<link rel="stylesheet" href="~/css/createBase.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/indexBase.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/select.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/validation.css" asp-append-version="true" />


<div class="content-container p-4 add-reporte-page" style="height: 100vh;">
    <div class="form-card" style="width: 100%; max-width: 100%; border-radius: 12px;">
        <h2 class="form-title text-center mb-4">GENERAR FACTURA</h2>

        <form asp-action="Create" method="post" id="formGenerarFactura" style="width: 100%; height: 100%; display: flex; flex-direction: column;">

            <!-- CONTENEDOR PRINCIPAL FLEX -->
            <div style="display: flex; gap: 20px; height: 100%;">

                <!-- FLEX IZQUIERDO -->
                <div style="flex: 3; display: flex; flex-direction: column; justify-content: space-between;">

                    <!-- FILA SUPERIOR: DISCIPLINA - PRODUCTO - CANTIDAD -->
                    <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                        <div style="width:100%; flex: 1;">
                            <div class="custom-select-container multiple" style="width:100%;">
                                <button type="button" class="custom-select-trigger">
                                    <span class="selected-value placeholder">Flitre por disciplina</span>
                                    <span class="arrow">▼</span>
                                </button>

                                @if (ViewBag.Disciplinas != null && ((IEnumerable<MVC.Models.DTOs.DisciplinaDto.DisciplinaReadDTO>)ViewBag.Disciplinas).Any())
                                {
                                    <ul class="custom-select-options">
                                        @foreach (var disciplina in (IEnumerable<MVC.Models.DTOs.DisciplinaDto.DisciplinaReadDTO>)ViewBag.Disciplinas)
                                        {
                                            <li data-value="@disciplina.Id">@disciplina.Nombre</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <ul class="custom-select-options">
										<li>No hay disciplinas disponibles</li>
                                    </ul>                                    
                                }
                                <input type="hidden" name="DisciplinaId" />
                            </div>
                        </div>

                        <div style="width:100%; flex: 1;">
                            <div class="custom-select-container multiple" style="width:100%;">
                                <button type="button" class="custom-select-trigger">
                                    <span class="selected-value placeholder">Seleccione una producto</span>
                                    <span class="arrow">▼</span>
                                </button>

                                @if (ViewBag.Productos != null && ((IEnumerable<MVC.Models.DTOs.ProductoDto.ProductoReadDTO>)ViewBag.Productos).Any())
                                {
                                    <ul class="custom-select-options">
                                        @foreach (var producto in (IEnumerable<MVC.Models.DTOs.ProductoDto.ProductoReadDTO>)ViewBag.Productos)
                                        {
                                            <li data-value="@producto.Id" data-precio="@producto.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                @producto.Nombre
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <ul class="custom-select-options">
										<li>No hay productos disponibles</li>
                                    </ul>               
                                }
                                <input type="hidden" name="ProductoId" />
                            </div>
                        </div>

                        <input type="number" id="cantidadInput" class="form-input" placeholder="Cantidad" min="1" style="flex: 1;" />
                    </div>

                    <!-- TABLA DE PRODUCTOS -->
                    <div class="tabla-productos-wrapper">
                        <table class="proveedores-table text-center" id="tablaProductos">
                            <thead>
                                <tr>
                                    <th style="width: 10%;">ID</th>
                                    <th style="width: 40%;">Nombre</th>
                                    <th style="width: 15%;">Precio Unitario</th>
                                    <th style="width: 15%;">Cantidad</th>
                                    <th style="width: 20%;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="no-data-row">
                                    <td colspan="5">No hay productos agregados</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- TOTAL Y USUARIO -->
                    <div class="totales-card mt-3">
                        <div class="totales-row">
                            <div class="totales-item">
                                <label>Total a pagar:</label>
                                <span id="totalPagar" class="valor-total">-</span>
                            </div>
                            <div class="totales-item">
                                <label>Usuario:</label>
                                <span class="valor-total">@User.Identity?.Name</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FLEX DERECHO -->
                <div style="flex: 1.2; display: flex; flex-direction: column; justify-content: space-between;">

                    <!-- FILA SUPERIOR: AGREGAR - ELIMINAR -->
                    <div style="display: flex; gap: 10px;">
                        <button type="button" id="btnAgregar" class="btn btn-edit w-50">AGREGAR</button>
                        <button type="button" id="btnEliminar" class="btn btn-secondary-g w-50">ELIMINAR</button>
                    </div>

                    <!-- DATOS DEL CLIENTE Y BOTONES -->
                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: space-between; margin-top: 10px;">
                        <div>
                            <input asp-for="DireccionFiscal" class="form-input mb-2" placeholder="Dirección Fiscal" required />
                            <input asp-for="IdFiscal" class="form-input mb-2" placeholder="Id Fiscal" required />
                            <input asp-for="RazonSocial" class="form-input mb-2" placeholder="Razón Social" required />

                            <div style="width:100%; flex: 1; margin-bottom: 14px;">
                                <div class="custom-select-container multiple" style="width:100%;">
                                    <button type="button" class="custom-select-trigger">
                                        <span class="selected-value placeholder">Seleccione un cliente</span>
                                        <span class="arrow">▼</span>
                                    </button>

                                    @if (ViewBag.Clientes != null && ((IEnumerable<MVC.Models.DTOs.ClienteDto.ClienteReadDTO>)ViewBag.Clientes).Any())
                                    {
                                        <ul class="custom-select-options">
                                            @foreach (var cliente in (IEnumerable<MVC.Models.DTOs.ClienteDto.ClienteReadDTO>)ViewBag.Clientes)
                                            {
                                                <li data-value="@cliente.Id">@cliente.Nombre</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <ul class="custom-select-options">
										    <li>No hay clientes disponibles</li>
                                        </ul>               
                                    }
                                    <input type="hidden" name="ClienteId" />
                                </div>
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column;">
                            <button type="button" class="btn btn-edit w-100 mb-2" id="btnNuevoCliente">
                                NUEVO CLIENTE
                            </button>
                            <button type="submit" class="btn btn-add w-100 mb-2">VENDER</button>
                            <a asp-action="Index" class="btn btn-delete w-100" style="margin-bottom: 0 !important;">CANCELAR</a>
                        </div>
                    </div>
                </div>
            </div>


            <!-- CAMPOS OCULTOS -->
            <input type="hidden" asp-for="UsuarioId" />
            <input type="hidden" asp-for="Monto" id="montoTotal" />
            <input type="hidden" asp-for="ProductosJson" id="productosJson" />
            <input type="hidden" asp-for="FechaEmision" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </form>
    </div>
</div>

<style>
    .btn {
        margin-bottom: 8px;
    }
    /* Contenedor flexible de la tabla de productos */
    .tabla-productos-wrapper {
        flex: 1 1 auto;              /* ocupa todo el espacio disponible */
        overflow-y: auto;            /* scroll vertical si excede el max-height */
        background: #0f141a;
        border-radius: 8px;
        box-shadow: 0 0 6px rgba(0,0,0,0.35);
        padding: 4px;
        max-height: 60vh;            /* altura máxima relativa al viewport */
        min-height: 250px;           /* altura mínima para mantener proporción */
    }

    /* Ajuste visual de la tabla dentro del contenedor */
    .tabla-productos-wrapper table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .tabla-productos-wrapper th,
    .tabla-productos-wrapper td {
        text-align: center;
    }
</style>

@section Scripts {
	<script src="~/js/select.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const selects = document.querySelectorAll('.custom-select-container');
            const disciplinaSelect = selects[0];
            const productoSelect = selects[1];

            const disciplinaHidden = disciplinaSelect.querySelector('input[type="hidden"]');
            const productoHidden = productoSelect.querySelector('input[type="hidden"]');

            const disciplinaTrigger = disciplinaSelect.querySelector('.custom-select-trigger');
            const productoTrigger = productoSelect.querySelector('.custom-select-trigger');

            const disciplinaOptions = disciplinaSelect.querySelector('.custom-select-options');
            const productoOptions = productoSelect.querySelector('.custom-select-options');

            const tablaProductos = document.querySelector("#tablaProductos tbody");
            const btnAgregar = document.getElementById("btnAgregar");
            const btnEliminar = document.getElementById("btnEliminar");
            const cantidadInput = document.getElementById("cantidadInput");
            const productosJsonInput = document.getElementById("productosJson");
            const totalPagarSpan = document.getElementById("totalPagar");
            const montoTotalInput = document.getElementById("montoTotal");

            let productos = [];

            function limpiarProductosSelect() {
                productoOptions.innerHTML = '<li>No hay productos disponibles</li>';
                productoHidden.value = '';
                productoTrigger.querySelector('.selected-value').textContent = 'Seleccione un producto';
            }

            function actualizarTabla() {
                tablaProductos.innerHTML = "";

                if (productos.length === 0) {
                    tablaProductos.innerHTML = `<tr class="no-data-row"><td colspan="5">No hay productos agregados</td></tr>`;
                    totalPagarSpan.textContent = "-";
                    productosJsonInput.value = "";
                    montoTotalInput.value = 0;
                    return;
                }

                let total = 0;
                productos.forEach(p => {
                    const subtotal = p.Cantidad * p.PrecioUnitario;
                    total += subtotal;

                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td>${p.ProductoId}</td>
                        <td>${p.Nombre}</td>
                        <td>$${(isFinite(p.PrecioUnitario) ? p.PrecioUnitario.toFixed(2) : "0.00")}</td>
                        <td>${p.Cantidad}</td>
                        <td>$${(isFinite(subtotal) ? subtotal.toFixed(2) : "0.00")}</td>
                    `;
                    tablaProductos.appendChild(row);
                });

                totalPagarSpan.textContent = `$${total.toFixed(2)}`;
                productosJsonInput.value = JSON.stringify(productos);
                montoTotalInput.value = total.toFixed(2);
            }

            // Evento disciplina -> trae productos
            disciplinaOptions.addEventListener('click', async function (e) {
                if (e.target.tagName === 'LI' && e.target.dataset.value) {
                    const disciplinaId = e.target.dataset.value;
                    disciplinaHidden.value = disciplinaId;
                    disciplinaTrigger.querySelector('.selected-value').textContent = e.target.textContent;

                    try {
                        const response = await fetch(`/Reportes/ProductosPorDisciplina?disciplinaId=${disciplinaId}`);
                        if (!response.ok) throw new Error('Error al obtener productos');

                        const productosResp = await response.json();

                        productoOptions.innerHTML = '';
                        if (productosResp.length > 0) {
                            productosResp.forEach(prod => {
                                // tolerante a varias formas de nombre de propiedad de precio
                                const rawPrice = prod.Precio ?? prod.precio ?? prod.Price ?? prod.price;
                                // si rawPrice es undefined o no numérico, fallback a 0
                                const parsedPrice = Number(rawPrice);
                                const precioVal = isFinite(parsedPrice) ? parsedPrice.toFixed(2) : "0.00";

                                const li = document.createElement('li');
                                li.textContent = prod.nombre ?? prod.Nombre ?? "(sin nombre)";
                                li.dataset.value = prod.id ?? prod.Id ?? "";
                                li.dataset.precio = precioVal; // string con 2 decimales
                                productoOptions.appendChild(li);
                            });
                        } else {
                            limpiarProductosSelect();
                        }

                        productoHidden.value = '';
                        productoTrigger.querySelector('.selected-value').textContent = 'Seleccione un producto';
                    } catch (error) {
                        console.error(error);
                        limpiarProductosSelect();
                    }
                }
            });

            // Selección de producto del select (DOM)
            productoOptions.addEventListener('click', function (e) {
                if (e.target.tagName === 'LI' && e.target.dataset.value) {
                    productoHidden.value = e.target.dataset.value;
                    productoTrigger.querySelector('.selected-value').textContent = e.target.textContent;
                }
            });

            // Agregar producto a la tabla
            btnAgregar.addEventListener("click", () => {
                const productoId = parseInt(productoHidden.value);
                const cantidad = parseInt(cantidadInput.value);

                if (!productoId || !cantidad || cantidad < 1) {
                    alert("Seleccione un producto y cantidad válida.");
                    return;
                }

                const productoLi = productoOptions.querySelector(`li[data-value='${productoId}']`);
                if (!productoLi) {
                    alert("No se encontró el producto seleccionado.");
                    return;
                }

                const nombreProducto = productoLi.textContent;
                const precioUnitario = parseFloat(productoLi.dataset.precio);
                if (!isFinite(precioUnitario)) {
                    alert("Precio inválido para el producto seleccionado.");
                    return;
                }

                const existente = productos.find(p => p.ProductoId === productoId);
                if (existente) {
                    existente.Cantidad += cantidad;
                } else {
                    productos.push({
                        ProductoId: productoId,
                        Nombre: nombreProducto,
                        Cantidad: cantidad,
                        PrecioUnitario: precioUnitario
                    });
                }

                actualizarTabla();

                // Limpiar selección
                productoHidden.value = '';
                cantidadInput.value = '';
                productoTrigger.querySelector('.selected-value').textContent = 'Seleccione un producto';
            });

            // Eliminar último producto
            btnEliminar.addEventListener("click", () => {
                productos.pop();
                actualizarTabla();
            });

            // Antes de enviar formulario
            const form = document.getElementById("formGenerarFactura");
            form.addEventListener("submit", () => {
                productosJsonInput.value = JSON.stringify(productos);
            });

            function agregarClienteAlSelectFactura(cliente) {
                if (!cliente) return;

                // localizar el contenedor del select de cliente por el input hidden ClienteId
                const clienteHiddenInput = document.querySelector('.custom-select-container input[name="ClienteId"]');
                const clienteContainer = clienteHiddenInput ? clienteHiddenInput.closest('.custom-select-container') : null;
                if (!clienteContainer) {
                    console.warn("No se encontró el select de clientes en la factura para actualizarlo.");
                    return;
                }

                const opcionesUl = clienteContainer.querySelector('.custom-select-options');
                if (!opcionesUl) {
                    console.warn("Select de clientes encontrado, pero no tiene .custom-select-options");
                    return;
                }

                // eliminar mensaje "No hay clientes disponibles" si existe como único hijo
                if (opcionesUl.children.length === 1) {
                    const firstText = opcionesUl.children[0].textContent?.trim().toLowerCase() ?? "";
                    if (firstText.includes('no hay clientes') || opcionesUl.children[0].classList.contains('disabled')) {
                        opcionesUl.innerHTML = '';
                    }
                }

                const nuevoId = cliente.id ?? cliente.Id ?? cliente.clienteId ?? cliente.ClienteId;
                const nuevoNombre = cliente.nombre ?? cliente.Nombre ?? "";

                // si ya existe un li con ese id, seleccionarlo y salir (y quitar clase placeholder)
                const existente = opcionesUl.querySelector(`li[data-value='${nuevoId}']`);
                const hidden = clienteContainer.querySelector('input[name="ClienteId"]');
                const selSpan = clienteContainer.querySelector('.selected-value');

                if (existente) {
                    if (hidden) hidden.value = nuevoId;
                    if (selSpan) {
                        selSpan.textContent = existente.textContent;
                        selSpan.classList.remove('placeholder'); // <-- QUITAR estilo placeholder
                    }
                    return;
                }

                // crear li nuevo
                const li = document.createElement('li');
                li.dataset.value = nuevoId;
                li.textContent = nuevoNombre || "(sin nombre)";

                // listener para que la opción funcione igual que las demás
                li.addEventListener('click', () => {
                    if (hidden) hidden.value = li.dataset.value;
                    if (selSpan) {
                        selSpan.textContent = li.textContent;
                        selSpan.classList.remove('placeholder'); // <-- QUITAR estilo placeholder
                    }
                });

                opcionesUl.appendChild(li);

                // seleccionarlo inmediatamente
                if (hidden) hidden.value = nuevoId;
                if (selSpan) {
                    selSpan.textContent = li.textContent;
                    selSpan.classList.remove('placeholder'); // <-- QUITAR estilo placeholder
                }

                // --- Intento adicional: si tu CustomSelect necesita re-inicializarse, intenta recrearlo ---
                try {
                    // Si tu select.js expone CustomSelect, volver a inicializar el contenedor evita inconsistencias
                    if (typeof CustomSelect !== 'undefined') {
                        // Opción simple: reiniciar creando una nueva instancia (si tu implementación lo tolera)
                        new CustomSelect(clienteContainer);
                    }
                } catch (err) {
                    // no fatal — sólo un intento para mantener compatibilidad con implementaciones que cachean opciones
                    console.warn("No se pudo re-inicializar CustomSelect tras agregar cliente:", err);
                }
            }


           // Función que inicializa el contenido del modal que viene por partial
            function initModalContent(modalEl) {
                // inicializa custom selects (tu CustomSelect debe estar definido en select.js)
                modalEl.querySelectorAll(".custom-select-container")
                       .forEach(c => {
                           try { new CustomSelect(c); }
                           catch (err) { console.warn("No se pudo inicializar CustomSelect:", err); }
                       });

                // referencias dentro del modal
                const form = modalEl.querySelector("#formAddCliente");
                const provinciaContainer = modalEl.querySelector("#provinciaSelectModal");
                const ciudadContainer = modalEl.querySelector("#ciudadSelectModal");

                // si no existe form, salimos
                if (!form) {
                    console.warn("formAddCliente no encontrado dentro del partial.");
                } else {
                    // re-attach listeners (adaptadas de tu partial)
                    // Cargar ciudades según provincia
                    if (provinciaContainer && ciudadContainer) {
                        const ciudadOptionsList = ciudadContainer.querySelector(".custom-select-options");

                        provinciaContainer.addEventListener("custom-select:change", async (e) => {
                            const provinciaNombre = e.detail?.text ?? "";
                            const provinciaNombreInput = provinciaContainer.querySelector("#ProvinciaNombreModal");
                            if (provinciaNombreInput) provinciaNombreInput.value = provinciaNombre;

                            ciudadOptionsList.innerHTML = "";
                            const sel = ciudadContainer.querySelector(".selected-value");
                            if (sel) sel.textContent = "Seleccione ciudad";
                            const ciudadIdInp = ciudadContainer.querySelector("input[name=CiudadId]");
                            if (ciudadIdInp) ciudadIdInp.value = "";
                            const ciudadNombreInp = ciudadContainer.querySelector("#CiudadNombreModal");
                            if (ciudadNombreInp) ciudadNombreInp.value = "";

                            try {
                                const res = await fetch(`/Clientes/GetCiudades?provinciaNombre=${encodeURIComponent(provinciaNombre)}`, { credentials: 'same-origin' });
                                if (!res.ok) { throw new Error("Respuesta no OK: " + res.status); }

                                const ciudades = await res.json();
                                ciudades.sort((a, b) => (a.nombre ?? "").localeCompare(b.nombre ?? ""));
                                ciudades.forEach(c => {
                                    const li = document.createElement("li");
                                    li.textContent = c.nombre;
                                    li.dataset.value = c.id ?? c.nombre;
                                    ciudadOptionsList.appendChild(li);
                                });
                            } catch (err) {
                                console.error("Error cargando ciudades:", err);
                                // mantener la UI estable
                                ciudadOptionsList.innerHTML = `<li class="disabled">Error cargando ciudades</li>`;
                            }
                        });

                        ciudadContainer.addEventListener("custom-select:change", (e) => {
                            const ciudadNombre = e.detail?.text ?? "";
                            const ciudadNombreInp = ciudadContainer.querySelector("#CiudadNombreModal");
                            if (ciudadNombreInp) ciudadNombreInp.value = ciudadNombre;
                        });
                    }

                    // envío AJAX del formulario
                    form.addEventListener("submit", async (ev) => {
                        ev.preventDefault();

                        const cliente = {
                            nombre: form.querySelector("[name='Nombre']")?.value ?? "",
                            dni: form.querySelector("[name='Dni']")?.value ?? "",
                            telefono: form.querySelector("[name='Telefono']")?.value ?? "",
                            direccion: form.querySelector("[name='Direccion']")?.value ?? "",
                            provincia: form.querySelector("[name='Provincia']")?.value ?? "",
                            ciudad: form.querySelector("[name='Ciudad']")?.value ?? ""
                        };

                        try {
                            const response = await fetch('/Clientes/CreatePartial', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                credentials: 'same-origin',
                                body: JSON.stringify(cliente)
                            });

                            if (!response.ok) {
                                console.error("CreatePartial returned", response.status, await response.text());
                                alert("Error al crear el cliente (server).");
                                return;
                            }

                            const result = await response.json();
                            if (result?.success) {
                                alert("Cliente agregado correctamente.");

                                // actualizar el select de clientes en la factura con el cliente devuelto
                                try {
                                    agregarClienteAlSelectFactura(result.cliente);
                                } catch (err) {
                                    console.warn("No se pudo actualizar select de clientes:", err);
                                }

                                // cerrar modal
                                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                                if (modalInstance) modalInstance.hide();
                                else {
                                    modalEl.classList.remove('show');
                                    modalEl.style.display = 'none';
                                    document.body.classList.remove('modal-open');
                                    const backdrop = document.querySelector('.modal-backdrop');
                                    if (backdrop) backdrop.remove();
                                }
                            }
                        } catch (err) {
                            console.error("Error al enviar el cliente:", err);
                            alert("Error de conexión con el servidor.");
                        }
                    });
                }
            }

            // handler del botón NUEVO CLIENTE
            document.getElementById("btnNuevoCliente").addEventListener("click", async () => {
                const container = document.getElementById("modalContainer");

                try {
                    // si ya existe el modal en DOM, simplemente abrirlo
                    let modalEl = document.getElementById("modalAddCliente");
                    if (!modalEl) {
                        // fetch solo si no está
                        const res = await fetch('@Url.Action("CreatePartial","Clientes")', { credentials: 'same-origin' });
                        if (!res.ok) {
                            const text = await res.text();
                            console.error("Error al obtener CreatePartial:", res.status, text);
                            alert("No se pudo cargar el formulario del cliente. Revisa la consola.");
                            return;
                        }

                        const html = await res.text();

                        // opcional: ayuda para debug si la respuesta es un login o html inesperado
                        if (!html.includes('id="modalAddCliente"')) {
                            console.error("La partial no contiene el modal esperado. Respuesta:", html);
                            container.innerHTML = "<!-- Error: partial inválida (ver consola) -->";
                            alert("Respuesta inválida al intentar cargar el modal (ver consola).");
                            return;
                        }

                        container.innerHTML = html;
                        modalEl = container.querySelector("#modalAddCliente");

                        if (!modalEl) {
                            console.error("modalAddCliente no encontrado tras insertar HTML.");
                            return;
                        }

                        // ejecutar inicializaciones necesarias del modal recién insertado
                        initModalContent(modalEl);
                    }

                    // crear/obtener instancia bootstrap y mostrar
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();

                } catch (err) {
                    console.error("Error al abrir modal:", err);
                }
            });


            // Inicializa tabla vacía
            actualizarTabla();
        });
    </script>
}