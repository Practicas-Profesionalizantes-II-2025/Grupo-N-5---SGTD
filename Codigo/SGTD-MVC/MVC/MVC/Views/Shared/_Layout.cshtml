@using MVC.Models.DTOs.RubroDto
@using MVC.Models.DTOs.DisciplinaDto
@using MVC.Models.DTOs.RolDto

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
</head>
<body>

    <!-- Barra superior -->
    <header class="topbar">
        <button class="menu-toggle" onclick="toggleSidebar()">
            <svg width="24" height="24" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16 12H42M16 24H42M16 36H42M6 12H6.02M6 24H6.02M6 36H6.02" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <span class="topbar-title">Sistema de Gestion de Tienda Deportiva</span>

        <div class="ms-auto">
            <button class="topbar-btn" data-bs-toggle="modal" data-bs-target="#modalRubros">
                Rubros
            </button>
            <button class="topbar-btn" data-bs-toggle="modal" data-bs-target="#modalDisciplinas">
                Disciplinas
            </button>
            <button class="topbar-btn" data-bs-toggle="modal" data-bs-target="#modalRoles">
                Roles
            </button>
        </div>

    </header>

    <!-- Sidebar -->
    <nav class="sidebar collapsed" id="sidebar">
        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" title="Inicio">
            <svg class="mar-18px" width="24" height="24" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 44V24H30V44M6 18L24 4L42 18V40C42 41.0609 41.5786 42.0783 40.8284 42.8284C40.0783 43.5786 39.0609 44 38 44H10C8.93913 44 7.92172 43.5786 7.17157 42.8284C6.42143 42.0783 6 41.0609 6 40V18Z" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>

            <i class="bi bi-house"></i><span class="nav-text">Inicio</span>
        </a>
        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Stock" ? "active" : "")" asp-controller="Stock" asp-action="Index" title="Stock">
            <svg class="mar-18px" width="24" height="24" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M42 16V42H6V16M20 24H28M2 6H46V16H2V6Z" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>

            <i class="bi bi-box-seam"></i><span class="nav-text">Stock</span>
        </a>
        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proveedores" ? "active" : "")" asp-controller="Proveedores" asp-action="Index" title="Proveedores">
            <svg class="mar-18px" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>

            <i class="bi bi-truck"></i><span class="nav-text">Proveedores</span>
        </a>
        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuarios" ? "active" : "")" asp-controller="Usuarios" asp-action="Index" title="Usuarios">
			<svg class="mar-18px" width="24" height="24" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M40 42V38C40 35.8783 39.1571 33.8434 37.6569 32.3431C36.1566 30.8429 34.1217 30 32 30H16C13.8783 30 11.8434 30.8429 10.3431 32.3431C8.84285 33.8434 8 35.8783 8 38V42M32 14C32 18.4183 28.4183 22 24 22C19.5817 22 16 18.4183 16 14C16 9.58172 19.5817 6 24 6C28.4183 6 32 9.58172 32 14Z" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
			</svg>

            <i class="bi bi-people"></i><span class="nav-text">Usuarios</span>
        </a>
        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reportes" ? "active" : "")" asp-controller="Reportes" asp-action="Index" title="Reportes">
            <svg class="mar-18px" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>

            <i class="bi bi-graph-up"></i><span class="nav-text">Reportes</span>
        </a>
        <a class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" ? "active" : "")" asp-controller="Clientes" asp-action="Index" title="Clientes">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.1552 19V17.4444C18.1552 16.6193 17.8338 15.828 17.2619 15.2445C16.69 14.6611 15.9142 14.3333 15.1054 14.3333H12.0556H9.00583C8.53912 14.3333 8.08343 14.4425 7.67155 14.6469C7.36962 14.7967 7.09122 14.9978 6.8493 15.2445C6.27737 15.828 5.95605 16.6193 5.95605 17.4444V19M15.1054 8.11111C15.1054 9.82934 13.74 11.2222 12.0556 11.2222C10.3713 11.2222 9.00583 9.82934 9.00583 8.11111C9.00583 6.39289 10.3713 5 12.0556 5C13.74 5 15.1054 6.39289 15.1054 8.11111Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M22.9999 15.5746V14.558C22.9999 14.0188 22.7896 13.5016 22.4152 13.1203C22.0408 12.7391 21.5331 12.5248 21.0037 12.5248H19.0074H18.0093M21.0037 8.45848C21.0037 9.58138 20.1099 10.4917 19.0074 10.4917C17.905 10.4917 17.0112 9.58138 17.0112 8.45848C17.0112 7.33558 17.905 6.42529 19.0074 6.42529C20.1099 6.42529 21.0037 7.33558 21.0037 8.45848Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M1.00012 15.5746V14.558C1.00012 14.0188 1.21045 13.5016 1.58479 13.1203C1.95916 12.7391 2.46692 12.5248 2.99634 12.5248H4.99255H5.99066M2.99634 8.45848C2.99634 9.58138 3.89007 10.4917 4.99255 10.4917C6.09504 10.4917 6.98877 9.58138 6.98877 8.45848C6.98877 7.33558 6.09504 6.42529 4.99255 6.42529C3.89007 6.42529 2.99634 7.33558 2.99634 8.45848Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <i class="bi bi-graph-up"></i><span class="nav-text">Clientes</span>
        </a>
        <form asp-controller="Cuenta" asp-action="Logout" method="post">
			<button class="btn-logout">
				<svg class="mar-18px" width="24" height="24" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M18 42H10C8.93913 42 7.92172 41.5786 7.17157 40.8284C6.42143 40.0783 6 39.0609 6 38V10C6 8.93913 6.42143 7.92172 7.17157 7.17157C7.92172 6.42143 8.93913 6 10 6H18M32 34L42 24M42 24L32 14M42 24H18" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
                <i class="bi bi-box-arrow-right"></i><span class="nav-text">Cerrar Sesión</span>
			</button>
        </form>
    </nav>

    <!-- Contenido -->
	<main class="content" id="main-content">
		@RenderBody()
        @RenderSection("Scripts", required: false)
        
        @await Html.PartialAsync("Modals/_ModalRubro", new List<RubroCreateDTO>())
        @await Html.PartialAsync("Modals/_ModalDisciplina", new List<DisciplinaCreateDTO>())
        @await Html.PartialAsync("Modals/_ModalRol", new List<RolCreateDTO>())
        @await Html.PartialAsync("Modals/_StockModal", new MVC.Models.ViewModels.ProductoStockVM())
    </main>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('expanded');
        }
    </script>


    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const urlsRubro = {
            getRubros: '@Url.Action("GetRubros", "Rubros")',
            crearRubro: '@Url.Action("CrearRubro", "Rubros")',
            modificarRubro: '@Url.Action("ModificarRubro", "Rubros")',
            eliminarRubro: '@Url.Action("EliminarRubro", "Rubros")'
        };
    </script>
    <script src="~/js/rubros.js"></script>

    <script>
        const urlsRol = {
            getRoles: '@Url.Action("GetRoles", "Roles")',
            crearRol: '@Url.Action("CrearRol", "Roles")',
            modificarRol: '@Url.Action("ModificarRol", "Roles")',
            eliminarRol: '@Url.Action("EliminarRol", "Roles")'
        };
    </script>
    <script src="~/js/roles.js"></script>

    <script>
        const urlsDisciplina = {
            getDisciplinas: '@Url.Action("GetDisciplinas", "Disciplinas")',
            crearDisciplina: '@Url.Action("CrearDisciplina", "Disciplinas")',
            modificarDisciplina: '@Url.Action("ModificarDisciplina", "Disciplinas")',
            eliminarDisciplina: '@Url.Action("EliminarDisciplina", "Disciplinas")'
        };
    </script>
    <script src="~/js/disciplinas.js"></script>
</body>
</html>
