@model MVC.Models.DTOs.ClienteDto.ClienteCreateDTO

<link rel="stylesheet" href="~/css/validation.css" asp-append-version="true" />

<div class="modal fade" id="modalAddCliente" tabindex="-1" aria-labelledby="modalAddClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalAddClienteLabel">Añadir Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body" id="modalBody">
                <form id="formAddCliente">
                    <div class="form-row">
                        <div style="width:100%;">
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-input", placeholder = "Nombre" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "validation-error" })
                        </div>
                        <div style="width:100%;">
                            @Html.TextBoxFor(m => m.Dni, new { @class = "form-input", placeholder = "DNI" })
                            @Html.ValidationMessageFor(m => m.Dni, "", new { @class = "validation-error" })
                        </div>
                    </div>

                    <div class="form-row">
                        <!-- Select Provincia -->
                        <div style="width:100%;">
                            <div class="custom-select-container @(ViewData.ModelState["Provincia"]?.Errors.Count > 0 ? "input-validation-error" : "")" id="provinciaSelectModal">
                                <button type="button" class="custom-select-trigger">
                                    <span class="selected-value placeholder">Seleccione provincia</span>
                                    <span class="arrow">▼</span>
                                </button>
                                <ul class="custom-select-options">
                                    @if (ViewBag.Provincias != null && ((IEnumerable<MVC.Controllers.ProvinciaDTO>)ViewBag.Provincias)?.Any() == true)
                                    {
                                        @foreach (var prov in (IEnumerable<MVC.Controllers.ProvinciaDTO>)ViewBag.Provincias)
                                        {
                                            <li data-value="@prov.Id">@prov.Nombre</li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="disabled">No hay provincias disponibles</li>
                                    }
                                </ul>
                                <input type="hidden" name="ProvinciaId" />
                                <input type="hidden" id="ProvinciaNombreModal" name="Provincia" />
                                @Html.ValidationMessageFor(m => m.Provincia, "", new { @class = "validation-error" })
                            </div>
                        </div>

                        <!-- Select Ciudad -->
                        <div style="width:100%;">
                            <div class="custom-select-container @(ViewData.ModelState["Ciudad"]?.Errors.Count > 0 ? "input-validation-error" : "")" id="ciudadSelectModal">
                                <button type="button" class="custom-select-trigger">
                                    <span class="selected-value placeholder">Seleccione ciudad</span>
                                    <span class="arrow">▼</span>
                                </button>
                                <ul class="custom-select-options">
                                    <!-- Se llena dinámicamente -->
                                </ul>
                                <input type="hidden" name="CiudadId" />
                                <input type="hidden" id="CiudadNombreModal" name="Ciudad" />
                                @Html.ValidationMessageFor(m => m.Ciudad, "", new { @class = "validation-error" })
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div style="width:100%;">
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-input", placeholder = "Teléfono" })
                            @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "validation-error" })
                        </div>
                        <div style="width:100%;">
                            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-input", placeholder = "Dirección" })
                            @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "validation-error" })
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-delete" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formAddCliente" class="btn btn-add">Añadir</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/select.js" asp-append-version="true"></script>

    <script>
        window.initClienteModal = function (modalRoot) {
            try {
                const modal = modalRoot || document.getElementById("modalAddCliente");
                if (!modal) {
                    console.warn("initClienteModal: modalAddCliente no encontrado");
                    return;
                }

                // Inicializa selects personalizados
                modal.querySelectorAll(".custom-select-container").forEach(c => {
                    try { new CustomSelect(c); } catch (err) { console.warn("No se pudo inicializar CustomSelect:", err); }
                });

                modal.addEventListener("shown.bs.modal", () => {
                    modal.querySelectorAll(".custom-select-container").forEach(c => {
                        try { new CustomSelect(c); } catch { }
                    });
                });

                const form = modal.querySelector("#formAddCliente");
                const provinciaContainer = modal.querySelector("#provinciaSelectModal");
                const ciudadContainer = modal.querySelector("#ciudadSelectModal");
                const ciudadOptionsList = ciudadContainer?.querySelector(".custom-select-options");

                // --- carga dinámica de ciudades ---
                if (provinciaContainer && ciudadContainer && ciudadOptionsList) {
                    provinciaContainer.addEventListener("custom-select:change", async (e) => {
                        const provinciaNombre = e?.detail?.text ?? "";
                        const provInput = provinciaContainer.querySelector("#ProvinciaNombreModal");
                        if (provInput) provInput.value = provinciaNombre;

                        ciudadOptionsList.innerHTML = "";
                        ciudadContainer.querySelector(".selected-value").textContent = "Seleccione ciudad";
                        ciudadContainer.querySelector("input[name=CiudadId]").value = "";
                        ciudadContainer.querySelector("#CiudadNombreModal").value = "";

                        try {
                            const res = await fetch(`/Clientes/GetCiudades?provinciaNombre=${encodeURIComponent(provinciaNombre)}`, { credentials: 'same-origin' });
                            if (!res.ok) throw new Error("Respuesta no OK: " + res.status);
                            const ciudades = await res.json();
                            ciudades.sort((a, b) => (a.nombre ?? "").localeCompare(b.nombre ?? ""));
                            ciudades.forEach(c => {
                                const li = document.createElement("li");
                                li.textContent = c.nombre;
                                li.dataset.value = c.id ?? c.nombre;
                                ciudadOptionsList.appendChild(li);
                            });
                        } catch (err) {
                            console.error("Error cargando ciudades:", err);
                            ciudadOptionsList.innerHTML = `<li class="disabled">Error cargando ciudades</li>`;
                        }
                    });

                    ciudadContainer.addEventListener("custom-select:change", (e) => {
                        const ciudadNombre = e?.detail?.text ?? "";
                        const ciudadNombreInp = ciudadContainer.querySelector("#CiudadNombreModal");
                        if (ciudadNombreInp) ciudadNombreInp.value = ciudadNombre;
                    });
                }

                // --- activar validaciones unobtrusive ---
                if (form && typeof $.validator !== 'undefined' && typeof $.validator.unobtrusive !== 'undefined') {
                    $.validator.unobtrusive.parse(form);
                }

                // --- submit AJAX ---
                if (form) {
                    form.removeEventListener('submit', window.__clienteFormHandler);
                    window.__clienteFormHandler = async function (ev) {
                        ev.preventDefault();

                        // ✅ validación del lado del cliente
                        if (!$(form).valid()) return;

                        const cliente = {
                            nombre: form.querySelector("[name='Nombre']")?.value ?? "",
                            dni: form.querySelector("[name='Dni']")?.value ?? "",
                            telefono: form.querySelector("[name='Telefono']")?.value ?? "",
                            direccion: form.querySelector("[name='Direccion']")?.value ?? "",
                            provincia: form.querySelector("[name='Provincia']")?.value ?? "",
                            ciudad: form.querySelector("[name='Ciudad']")?.value ?? ""
                        };

                        try {
                            const response = await fetch('/Clientes/CreatePartial', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                credentials: 'same-origin',
                                body: JSON.stringify(cliente)
                            });

                            if (!response.ok) {
                                console.error("CreatePartial returned", response.status, await response.text());
                                alert("Error al crear el cliente (server).");
                                return;
                            }

                            const result = await response.json();
                            if (result?.success) {
                                alert("Cliente agregado correctamente.");
                                const instance = bootstrap.Modal.getInstance(modal);
                                if (instance) instance.hide();
                            } else {
                                alert("Error al crear el cliente.");
                                console.warn("CreatePartial no devolvió success:", result);
                            }
                        } catch (err) {
                            console.error("Error al enviar el cliente:", err);
                            alert("Error de conexión con el servidor.");
                        }
                    };
                    form.addEventListener('submit', window.__clienteFormHandler);
                }
            } catch (err) {
                console.error("initClienteModal error:", err);
            }
        };
    </script>
}

