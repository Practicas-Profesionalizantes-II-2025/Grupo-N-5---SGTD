@{
    ViewData["Title"] = "Inicio";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<div class="inicio-background d-flex flex-column align-items-center text-center p-3">

    <!-- Texto superior -->
    <div class="welcome-section">
        <h1 class="welcome-title">BIENVENIDO</h1>
        <p class="text-muted">
            Gestiona tus productos, ventas y proveedores de forma rápida y sencilla.
        </p>
    </div>

    <!-- Acciones -->
    <div class="actions container mt-auto">
        <div class="row justify-content-center g-5">
            <div class="col custom-col-5">
                <a asp-controller="Stock" asp-action="Index" class="card shadow-sm h-100 text-decoration-none">
                    <div class="card-body">
                        <div class="card-title">
                            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M42 16V42H6V16M20 24H28M2 6H46V16H2V6Z" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <h5 class="card-title">Stock</h5>
                    </div>
                </a>
            </div>
